{
  "expo": {
    "name": "StockTrack",
    "slug": "InventoryMonitorApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/stocktrack-logo.png",
    "scheme": "inventorymonitorapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/stocktrack-logo.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow StockTrack to access your camera for barcode scanning"
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F2F3F2",
        "foregroundImage": "./assets/images/stocktrack-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jedeann23.InventoryMonitorApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/stocktrack-logo.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StockTrack to access your camera for barcode scanning",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow StockTrack to use Face ID to unlock your signed-in account."
        }
      ],
      "expo-sharing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/stocktrack-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08a78a25-85ec-4b34-97f0-d2dd1a9fc960"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/08a78a25-85ec-4b34-97f0-d2dd1a9fc960"
    }
  }
}
